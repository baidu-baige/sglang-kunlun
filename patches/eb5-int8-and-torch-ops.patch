+def alloc_decode_naive(
+    seq_lens: torch.Tensor,
+    last_loc: torch.Tensor,
+    free_pages: torch.Tensor,
+    out_indices: torch.Tensor,
+    page_size: int,
+):
+    """``alloc_decode_kernel`` 的纯 torch 实现（昆仑无 Triton）。
+
+    逐请求复刻原 kernel：每条请求只新增 0/1 个页；
+    ``new_i = ceil(seq/page) - ceil((seq-1)/page)``，该请求的新页号是
+    ``free_pages[Σ_{j<i} new_j]``，不需要新页时 ``out = last_loc + 1``。
+    """
+    pre_lens = seq_lens - 1
+    num_after = (seq_lens + page_size - 1) // page_size
+    num_before = (pre_lens + page_size - 1) // page_size
+    new_flags = (num_after - num_before).to(torch.int64)
+    needs_new = new_flags > 0
+
+    # 用 free_pages.numel()（host 已知）做分支，避免 needs_new.any() 的 D2H
+    # 同步 —— 昆仑设备半坏时那个 .item() 会永久挂住。
+    if free_pages.numel() > 0:
+        start = torch.cumsum(new_flags, 0) - new_flags
+        page = free_pages[start.clamp(min=0, max=free_pages.numel() - 1)]
+        val_new = page * page_size
+    else:
+        val_new = torch.zeros_like(last_loc)
+    out = torch.where(needs_new, val_new, last_loc + 1)
+    out_indices.copy_(out.to(out_indices.dtype))
+
