     "SGLANG_INTERNAL_ATTENTIONSTORE_INDEX_CONFIG", ""
 )
+
+# bingoo: online 128x128 blockwise INT8 (BF16 ckpt -> INT8 at load time) for
+# Kunlun P800, which has no FP8 GEMM. Master gate: when unset only the
+# `blockwise_int8_online` quantization name is registered, so every existing
+# (BF16 / blockwise_fp8) run is unaffected. See
+# internal/layers/quantization/blockwise_int8_patch.py.
+EB5_INT8_ONLINE: bool = get_bool_env_var("EB5_INT8_ONLINE", default="false")
+# Quantize the routed experts only, keeping every dense projection in BF16.
+EB5_INT8_MOE_ONLY: bool = get_bool_env_var("EB5_INT8_MOE_ONLY", default="false")
+# Stage the BF16 expert placeholders on CPU and quantize one expert at a time
+# on the device (peak = int8_all + bf16_one_expert instead of both full copies).
+EB5_INT8_MOE_CPU_STAGING: bool = get_bool_env_var(
+    "EB5_INT8_MOE_CPU_STAGING", default="true"
+)
+# Stage the BF16 dense placeholders on CPU as well (see the OOM note in
+# Int8LinearMethod.create_weights).  Off by default: EB5's full-MLA
+# `post_load_weights` builds the absorb buffers (w_kc/w_vc) from
+# `kv_b_proj.weight` *before* the quant pass runs, so a CPU-resident dense
+# placeholder yields CPU absorb buffers and the first forward dies with
+# "mat2 is on cpu".  Turn it on only together with a fix that re-derives those
+# buffers after quantization (needed for a dense-INT8 43-layer load on <= 4
+# cards; with EB5_INT8_MOE_ONLY=1 the dense layers stay BF16 and this is moot).
+EB5_INT8_LINEAR_CPU_STAGING: bool = get_bool_env_var(
+    "EB5_INT8_LINEAR_CPU_STAGING", default="false"
+)
