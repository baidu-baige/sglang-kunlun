diff --git a/python/sglang/srt/multimodal/processors/deepseek_v41.py b/python/sglang/srt/multimodal/processors/deepseek_v41.py
index dc18812f2f..19673adbc5 100644
--- a/python/sglang/srt/multimodal/processors/deepseek_v41.py
+++ b/python/sglang/srt/multimodal/processors/deepseek_v41.py
@@ -125,3 +125,110 @@ class DeepseekV41ImageProcessor(BaseMultimodalProcessor):
             mm_items=self._prepare_mm_items_for_transport(items),
             im_token_id=self.image_token_id,
         )
+
+    # [epd-dsv41] Language-only side of New EPD: rebuild the encoder's spans.
+    def get_mm_data(self, prompt, embeddings, **kwargs):
+        """Rebuild the image spans for embeddings received from an encoder.
+
+        The base implementation derives a span length from a patch grid, which
+        does not describe V4.1: an image occupies ``n_llm_h * (n_llm_w + 1) + 2``
+        tokens -- the aligner grid in reading order plus one IMAGE_NEW_LINE per
+        row and the two delimiters. The encoder returns that whole span (see
+        DeepseekV4ForCausalLM.get_image_feature), so span length and embedding
+        rows match one-to-one here.
+
+        ``img_grid_thw`` arrives from the receiver, which fills one entry per
+        encoder part and concatenates them in global part order; the rows are
+        therefore in prompt image order, one per ``image_token_id``
+        placeholder. The part ids themselves (``<rid>_local_part_<idx>``) are
+        consumed by the receiver before this point and are not needed here.
+        """
+        grid = kwargs.get("img_grid_thw")
+        if grid is None:
+            raise ValueError("DeepSeek-V4.1 EPD requires img_grid_thw per image")
+        grid = torch.as_tensor(grid).reshape(-1, 3)
+
+        if isinstance(prompt, (list, tuple)):
+            ids = list(prompt)
+        else:
+            ids = self._processor.encode(prompt)
+        num_placeholders = ids.count(self.image_token_id)
+        if num_placeholders != grid.shape[0]:
+            raise ValueError(
+                f"{num_placeholders} image placeholders for {grid.shape[0]} "
+                "encoder grids"
+            )
+
+        # Mirror the encoder-side guard (encoder/preprocessor.get_num_tokens) so a
+        # missing or zero ratio cannot turn the ceil-division below into a crash;
+        # both sides must read the same ratio or the span lengths would diverge.
+        r = getattr(self.hf_config, "vision_downsample_ratio", 3) or 3
+        image_embeddings = embeddings.get(Modality.IMAGE)
+        if image_embeddings is None:
+            raise ValueError(
+                "DeepSeek-V4.1 EPD received no IMAGE embeddings from the encoder"
+            )
+        tokens, items, consumed, index = [], [], 0, 0
+        for token in ids:
+            if token != self.image_token_id:
+                tokens.append(token)
+                continue
+            _, n_vit_h, n_vit_w = (int(value) for value in grid[index])
+            n_llm_h = -(-n_vit_h // r)
+            n_llm_w = -(-n_vit_w // r)
+            count = len(image_token_types(n_llm_h, n_llm_w))
+            if consumed + count > len(image_embeddings):
+                raise ValueError(
+                    f"DeepSeek-V4.1 EPD: encoder returned {len(image_embeddings)} "
+                    f"embedding rows but image {index} needs rows "
+                    f"[{consumed}:{consumed + count}]"
+                )
+            start = len(tokens)
+            tokens.extend([self.image_token_id] * count)
+            items.append(
+                MultimodalDataItem(
+                    modality=Modality.IMAGE,
+                    offsets=[(start, start + count - 1)],
+                    precomputed_embeddings=image_embeddings[
+                        consumed : consumed + count
+                    ],
+                    model_specific_data={"n_vit_h": n_vit_h, "n_vit_w": n_vit_w},
+                )
+            )
+            consumed += count
+            index += 1
+
+        if consumed != len(image_embeddings):
+            raise ValueError(
+                f"DeepSeek-V4.1 EPD: consumed {consumed} embedding rows but the "
+                f"encoder returned {len(image_embeddings)}"
+            )
+
+        # [epd-dsv41] Evidence line for the E->P hop: both sides of the row
+        # accounting are real measurements from this request (rows the encoder
+        # pushed, tokens the language-only span rebuild consumed). The finite /
+        # scale part is what distinguishes "the encoder pushed a wrong embedding"
+        # from "the language side consumed it wrongly": a NaN/inf or a wildly
+        # out-of-range max here means the encoder's ViT forward itself blew up.
+        _emb = image_embeddings.reshape(-1, image_embeddings.shape[-1])
+        logger.info(
+            "[epd-dsv41] ep_transfer rid=%s images=%d embedding_rows=%d "
+            "image_tokens=%d matched=%s dtype=%s finite=%s absmax=%.4f "
+            "mean=%.4f std=%.4f",
+            kwargs.get("rid", "n/a"),
+            int(grid.shape[0]),
+            len(image_embeddings),
+            consumed,
+            consumed == len(image_embeddings),
+            str(_emb.dtype),
+            bool(torch.isfinite(_emb).all()),
+            float(_emb.abs().max()),
+            float(_emb.float().mean()),
+            float(_emb.float().std()),
+        )
+
+        return MultimodalProcessorOutput(
+            input_ids=tokens,
+            mm_items=items,
+            im_token_id=self.image_token_id,
+        )
