# Kunlun component URLs for Dockerfile.xpu
#
# Usage:
#   docker build -f Dockerfile.xpu -t klx-sglang:test \
#     $(sed -e '/^#/d' -e '/^$/d' -e 's/^/--build-arg /' kunlun-components.env | tr '\n' ' ') .
#
# Every variable below is required; the build fails early if one is empty.
# Release notes and the authoritative URLs live in the Kunlun release wiki;
# a built image also records what it used under /versions.
#
# PYTHON_VERSION / TORCH_VERSION in the Dockerfile must match the cpXXX and
# torchXXX tags in XPYTORCH_URL (cp310 / torch290 -> 3.10 / 2.9.0).
#
# XRE_URL accepts both the .tar.gz and the Makeself .run flavor; the Dockerfile
# picks the right unpack path from the file suffix. XRE and XCCL must be a
# matched pair, a mismatched libbkcl/XRE combination segfaults when sglang
# builds its world group.

XPYTORCH_URL=https://klx-sdk-release-public.su.bcebos.com/kunlun2jituan/20260806/xpytorch-cp310-torch290-ubuntu2004-x64.run
KUNLUN_OPS_URL=https://klx-sdk-release-public.su.bcebos.com/kunlun2jituan/20260806/kunlun_ops-0.1.227%2B2b100f96-cp310-cp310-linux_x86_64.whl
XRE_URL=https://klx-sdk-release-public.su.bcebos.com/xre/kl3-release/5.42.0.0/peermem/xre-Linux-x86_64-5.42.0.0.tar.gz
XCCL_URL=https://klx-sdk-release-public.su.bcebos.com/xccl/release/3.2.8.0/xccl_Linux_x86_64.tar.gz
DEEPEP_URL=https://su.bcebos.com/v1/klx-sdk-release-public/DS_PD/deepep/3.1.8.1/deep_ep-cp310-cp310-linux_x86_64_cuda12.tar.gz
MOONCAKE_URL=https://su.bcebos.com/v1/klx-sdk-release-public/DS_PD/xmooncake/20250912_9/output.tar.gz
XSPEEDGATE_URL=https://aihc-private-hcd.bj.bcebos.com/xspeedgate_release/torch29/20260828_150025/xspeedgate_ops-1.5.1%2B6c46c35.torch29-cp310-cp310-linux_x86_64.whl
